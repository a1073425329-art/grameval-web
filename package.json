{
  "name": "grameval-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "engineStrict": true,
  "scripts": {
    "preinstall": "node scripts/check-env.cjs",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint:vue": "node scripts/lint-vue.mjs",
    "lint:eslint": "eslint src/**/*.{ts,vue}",
    "lint:eslint:fix": "eslint src/**/*.{ts,vue} --fix",
    "lint": "npm run lint:vue && npm run lint:eslint",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e tests/admin.test.ts tests/student.test.ts",
    "verify": "node scripts/verify.mjs",
    "verify:no-e2e": "node scripts/verify.mjs --skip-e2e"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fuxishi/svg-icon": "^1.0.7",
    "@iconify/vue": "^5.0.1",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@yh-ui/icons": "^1.0.63",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "pinia": "^4.0.2",
    "sass": "^1.101.0",
    "vue": "^3.5.39",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.505",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "terser": "^5.49.0",
    "ts-type-cleaner": "^5.1.0",
    "typescript": "~6.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
